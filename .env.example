# Figma Visual Regression Testing
# Get your Figma access token from: https://www.figma.com/developers/api#access-tokens
FIGMA_ACCESS_TOKEN=figd_your_token_here

# Figma file key (extract from Figma URL)
# Example URL: https://figma.com/design/abc123xyz/FileName
# File key would be: abc123xyz
FIGMA_FILE_KEY=your_file_key_here

# Chromatic (Visual Regression Testing)
# Get your project token from: https://www.chromatic.com/
CHROMATIC_PROJECT_TOKEN=chpt_your_token_here
